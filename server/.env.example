# Copy this to `.env` and fill values.
# For Docker host mode, DB_PORT is usually 3310.
# For Railway MySQL or container-to-container networking, use 3306.

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional alternative: CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

JWT_SECRET=some_super_secret_value
CERTIFICATE_HMAC_SECRET=replace_with_a_long_random_secret

# Comma-separated list for local + production + preview domains.
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false

DB_HOST=mysql
DB_PORT=3310
DB_USER=root
DB_PASSWORD=root
DB_NAME=elearn_db
PORT=5000
